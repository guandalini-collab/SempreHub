# Copie para .env e ajuste. Em desenvolvimento nada disto é obrigatório.

# "producao" ativa as verificações de segurança (exige chave e código docente próprios)
SEMPREHUB_AMBIENTE=desenvolvimento

# Gere uma chave longa e aleatória, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SEMPREHUB_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Código que o professor informa ao criar a conta. Divulgue só para docentes.
SEMPREHUB_CODIGO_DOCENTE=troque-este-codigo

# Banco de dados. Padrão: arquivo SQLite local.
# Em servidor, prefira PostgreSQL:
#   DATABASE_URL=postgresql://usuario:senha@host:5432/semprehub
DATABASE_URL=sqlite:///./semprehub.db

# Domínios de e-mail aceitos (separados por vírgula)
SEMPREHUB_DOMINIOS_ALUNO=aluno.iffarroupilha.edu.br,aluno.iffar.edu.br
SEMPREHUB_DOMINIOS_PROFESSOR=iffarroupilha.edu.br,iffar.edu.br,gmail.com

# Endereços que podem chamar a API quando o frontend roda em outro domínio
SEMPREHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Validade do login, em horas
SEMPREHUB_TOKEN_HORAS=12

# Endereço público do sistema (usado no link de recuperação de senha)
SEMPREHUB_URL_PUBLICA=http://127.0.0.1:8000
SEMPREHUB_RECUPERACAO_MINUTOS=60

# Envio de e-mail para recuperação de senha (opcional).
# Opção 1 — Resend (API HTTPS). Use no Railway Free/Hobby, que bloqueia SMTP.
#   RESEND_API_KEY=re_...
#   EMAIL_REMETENTE=SempreHub <nao-responda@seudominio.com.br>
#
# Opção 2 — SMTP.
# Sem SMTP_HOST, o link aparece no log do servidor e, em desenvolvimento, na própria tela.
# Exemplo com Gmail (exige "senha de app" da conta Google):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORTA=587
#   SMTP_USUARIO=seuemail@gmail.com
#   SMTP_SENHA=senha-de-app
#   SMTP_REMETENTE=SempreHub <seuemail@gmail.com>
#   SMTP_TLS=starttls
SMTP_HOST=

# Pesquisa de mercado e relatórios empresariais (OpenAI Responses API)
OPENAI_API_KEY=
SEMPREHUB_OPENAI_MODEL=gpt-4.1-mini
