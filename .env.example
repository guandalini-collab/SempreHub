# Copie para .env e ajuste. Em desenvolvimento nada disto é obrigatório.

# "producao" ativa as verificações de segurança (exige chave e código docente próprios)
SEMPREHUB_AMBIENTE=desenvolvimento

# Gere uma chave longa e aleatória, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SEMPREHUB_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Código que o professor informa ao criar a conta. Divulgue só para docentes.
SEMPREHUB_CODIGO_DOCENTE=troque-este-codigo

# Banco de dados. Padrão: arquivo SQLite local.
# Em servidor, prefira PostgreSQL:
#   DATABASE_URL=postgresql://usuario:senha@host:5432/semprehub
DATABASE_URL=sqlite:///./semprehub.db

# Domínios de e-mail aceitos (separados por vírgula)
SEMPREHUB_DOMINIOS_ALUNO=aluno.iffarroupilha.edu.br,aluno.iffar.edu.br
SEMPREHUB_DOMINIOS_PROFESSOR=iffarroupilha.edu.br,iffar.edu.br

# Endereços que podem chamar a API quando o frontend roda em outro domínio
SEMPREHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Validade do login, em horas
SEMPREHUB_TOKEN_HORAS=12
